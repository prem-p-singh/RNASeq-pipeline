{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "RNASeq Pipeline v2.1",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {"entries": {
      "frontend": {"label": "Intake"}, "backend": {"label": "Processing step"},
      "security": {"label": "Gate"}, "database": {"label": "Data product"},
      "cloud": {"label": "Optional analysis"}, "external": {"label": "Report"}}}
  },
  "lanes": [
    {"id": "config", "label": "Describe + check"},
    {"id": "sample", "label": "Per-sample processing"},
    {"id": "cohort", "label": "Cohort inference"},
    {"id": "optional", "label": "Optional analyses"}
  ],
  "groups": [
    {"id": "optional_work", "label": "Needs OrgDb / eligible cohort", "lane": "optional", "fromCol": 4, "toCol": 5, "variant": "dashed"}
  ],
  "mainPath": ["intake", "review", "preflight", "prep", "fastp", "quant", "counts", "de"],
  "nodes": [
    {"id": "intake", "lane": "config", "col": 0, "type": "frontend", "label": "Study intake", "sublabel": "Excel or YAML + TSV", "width": 140},
    {"id": "review", "lane": "config", "col": 1, "type": "backend", "label": "Setup + review", "sublabel": "goal, model, contrasts", "width": 140},
    {"id": "preflight", "lane": "config", "col": 2, "type": "security", "label": "Preflight", "sublabel": "route, design, inputs", "width": 140},
    {"id": "index", "lane": "config", "col": 4, "type": "database", "label": "Reference", "sublabel": "Salmon or STAR index", "width": 140},
    {"id": "prep", "lane": "sample", "col": 2, "type": "backend", "label": "Prepare reads", "sublabel": "verify mates, merge lanes", "width": 140},
    {"id": "fastp", "lane": "sample", "col": 3, "type": "backend", "label": "fastp", "sublabel": "trim, QC, read ledger", "width": 140},
    {"id": "quant", "lane": "sample", "col": 4, "type": "backend", "label": "Quantify", "sublabel": "Salmon or STAR", "width": 140},
    {"id": "multiqc", "lane": "sample", "col": 5, "type": "external", "label": "QC report", "sublabel": "MultiQC + comparative", "width": 140},
    {"id": "counts", "lane": "cohort", "col": 4, "type": "database", "label": "Gene counts", "sublabel": "tximport or featureCounts", "width": 140},
    {"id": "de", "lane": "cohort", "col": 5, "type": "backend", "label": "DE model", "sublabel": "limma, edgeR, DESeq2", "width": 140},
    {"id": "screen", "lane": "optional", "col": 3, "type": "cloud", "label": "Read screening", "sublabel": "FastQ Screen panel", "width": 140},
    {"id": "wgcna", "lane": "optional", "col": 4, "type": "cloud", "label": "WGCNA", "sublabel": "co-expression modules", "width": 140},
    {"id": "enrich", "lane": "optional", "col": 5, "type": "cloud", "label": "GO / KEGG", "sublabel": "enrichment", "width": 140}
  ],
  "edges": [
    {"id": "intake-review", "from": "intake", "to": "review"},
    {"id": "review-preflight", "from": "review", "to": "preflight"},
    {"id": "preflight-prep", "from": "preflight", "to": "prep", "label": "each sample", "variant": "emphasis"},
    {"id": "preflight-index", "from": "preflight", "to": "index", "role": "branch"},
    {"id": "prep-fastp", "from": "prep", "to": "fastp"},
    {"id": "fastp-quant", "from": "fastp", "to": "quant"},
    {"id": "fastp-screen", "from": "fastp", "to": "screen", "variant": "dashed", "role": "branch"},
    {"id": "index-quant", "from": "index", "to": "quant", "label": "index", "role": "branch"},
    {"id": "quant-qc", "from": "quant", "to": "multiqc", "role": "branch"},
    {"id": "quant-counts", "from": "quant", "to": "counts", "label": "counts", "variant": "emphasis"},
    {"id": "counts-de", "from": "counts", "to": "de"},
    {"id": "de-enrich", "from": "de", "to": "enrich", "label": "DE tables", "variant": "dashed", "role": "branch"},
    {"id": "de-wgcna", "from": "de", "to": "wgcna", "variant": "dashed", "role": "branch"}
  ],
  "cards": [
    {"dot": "cyan", "title": "Execution", "items": ["Snakemake locally on Linux or through SLURM", "Per-project configuration, logs and results"]},
    {"dot": "amber", "title": "Choices", "items": ["Salmon, or STAR with featureCounts", "limma-voom or dream, edgeR QL, DESeq2 Wald"]}
  ]
}
