cff-version: 1.2.0
title: "RNASeq-pipeline: Excel-driven, reproducible bulk RNA-seq analysis"
version: "2.0.0"
date-released: "2026-09-23"
message: "If this workflow contributes to published work, please cite it as below."
type: software
authors:
