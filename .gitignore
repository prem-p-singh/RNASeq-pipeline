# --- Per-run / per-project state -------------------------------------
# Generated by a run, not source. Each project writes its own copies, so
# tracking them would make every run look like a change.
results/
reference/
metrics/
gates/
logs/
tmp/
.snakemake/

# --- Generated configuration ------------------------------------------
# setup.py writes these from setup_inputs.yaml. The templates beside them
# (config.template.yaml, samples.tsv.template, thresholds.yaml) ARE tracked.
config/config.yaml
config/samples.tsv
setup_inputs.yaml

# --- Third-party documents --------------------------------------------
# Kept out of version control so the repo can be pushed without
# redistributing third-party handbooks.
*.pdf

# --- Local editor / tooling state -------------------------------------
.claude/settings.local.json
.DS_Store
.Rhistory
.RData
__pycache__/
*.pyc

# --- Internal working documents ---------------------------------------
# Audit and upgrade-planning notes. Kept on disk, deliberately not published:
# they are not required to install or run the pipeline.
AUDIT.md
REPAIR_UPGRADE_REAUDIT.md
PIPELINE_AUDIT_REPAIRS_AND_UPGRADE_PLAN.md

# Local audit trackers and raw cluster evidence are not release documentation.
docs/WORKING_PLAN.md
docs/INTAKE_HANDBOOK_IMPLEMENTATION_PLAN.md
docs/evidence/
HANDBOOK_COVERAGE_MAP.md
RNA_SEQ_RECOMMENDATION_RULES.md
docs/PIPELINE_IMPLEMENTATION_AUDIT_*.md
docs/archive/

# Generated source release archives.
/dist/
